<Window x:Class="Browser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Browser"
        xmlns:cef="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
        xmlns:dragablz="clr-namespace:Dragablz;assembly=Dragablz"
        mc:Ignorable="d"
        WindowStyle="None"
        Background="#EEE"
        ResizeMode="CanResize"
        Title="MainWindow">

    <Window.Resources>
        <!--dragablz layout-->
        <ControlTemplate TargetType="{x:Type dragablz:TabablzControl}" x:Key="asd">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <dragablz:DragablzItemsControl x:Name="PART_HeaderItemsControl" Grid.Row="0" />
                <Border Grid.Row="1">
                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Grid.Row="1" Margin="8"/>
                </Border>
            </Grid>
        </ControlTemplate>
