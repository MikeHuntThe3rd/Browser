<UserControl x:Class="Browser.home"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Browser"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White">
            <ListBox x:Name="favourites" ItemsSource="{x:Static local:GlobalData.favs}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:fav}">
                        <StackPanel Orientation="Horizontal">
                            <Button Click="Button_Click" >
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}"/>
                                    <Label Content="{Binding Title}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <Grid Grid.Row="1" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border HorizontalAlignment="Center" Grid.Row="0" Grid.Column="1">
                <Canvas Name="MainCanvas" ClipToBounds="True" Background="Transparent" Width="130">
                    <Canvas.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <!-- Top fade -->
                            <GradientStop Color="Transparent" Offset="0.0"/>
                            <GradientStop Color="White" Offset="0.15"/>

                            <!-- Fully visible middle -->
                            <GradientStop Color="White" Offset="0.85"/>

                            <!-- Bottom fade -->
                            <GradientStop Color="Transparent" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Canvas.OpacityMask>
                    <Image Name="TopImage" />
                    <Image Name="BottomImage" />
                </Canvas>
            </Border>
            <Grid Grid.Row="1" Grid.ColumnSpan="3">
                <Border CornerRadius="20"
                        Background="White"
                        BorderBrush="#DADCE0"
                        BorderThickness="2"
                        Margin="10,10,10,10"
                        Width="400" Height="36"
                        VerticalAlignment="Top">
                    <Grid>
                        <TextBox x:Name="search"
                  Text="{Binding Url}"
                  Background="Transparent"
                  Foreground="Black"
                  BorderThickness="0"
                  Padding="12,6"
                  FontSize="14"
                  VerticalContentAlignment="Center"
                  KeyDown="TextBlock_KeyDown"/>
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Row="0" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Width="32" Height="32" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="16" Margin="10" Background="#E9EAEC">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#E9EAEC"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                     To="#D0D0D0" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                     To="#E9EAEC" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Button x:Name="options" 
            Content="⋮" 
            FontSize="16"
            Background="Transparent"
            BorderThickness="0"
            FocusVisualStyle="{x:Null}"
            Foreground="#5F6368"
            Click="options_Click"/>
                </Border>
                <Grid Grid.Row="1" >
                    <!--AMONGUS-->
                </Grid>
            </Grid>
        </Grid>

    </Grid>
</UserControl>
