<UserControl x:Class="Browser.home"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Browser"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <!-- ================= STYLES ================= -->
    <UserControl.Resources>

        <!-- MENU CARD -->
        <Style x:Key="MenuCard" TargetType="Border">
            <Setter Property="Background" Value="#F5F6F8"/>
            <Setter Property="BorderBrush" Value="#DADCE0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10"
                                      Opacity="0.2"
                                      ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MENU BUTTON -->
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Background" Value="#E9EAEC"/>
            <Setter Property="Foreground" Value="#202124"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                >
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd"
                                        Property="Background"
                                        Value="#D0D0D0"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd"
                                        Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96"
                                                        ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MENU TEXTBOX -->
        <Style x:Key="MenuTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DADCE0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

    </UserControl.Resources>

    <!-- ================= LAYOUT ================= -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- FAV BAR -->
        <Border Grid.Row="0" Background="White">
            <ListBox x:Name="favourites"
                     ItemsSource="{x:Static local:GlobalData.favs}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:fav}">
                        <Button Click="Button_Click"
                                MouseRightButtonDown="Button_MouseRightButtonDown">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Icon}" />
                                <Label Content="{Binding Title}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- MAIN -->
        <Grid Grid.Row="1" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LOGO -->
            <Border HorizontalAlignment="Center"
                    Grid.Row="0"
                    Grid.Column="1">
                <Canvas Name="MainCanvas"
                        ClipToBounds="True"
                        Background="Transparent"
                        Width="130">
                    <Canvas.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="White" Offset="0.15"/>
                            <GradientStop Color="White" Offset="0.85"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Canvas.OpacityMask>
                    <Image Name="TopImage"/>
                    <Image Name="BottomImage"/>
                </Canvas>
            </Border>

            <!-- SEARCH -->
            <Grid Grid.Row="1" Grid.ColumnSpan="3">
                <Border CornerRadius="20"
                        Background="White"
                        BorderBrush="#DADCE0"
                        BorderThickness="2"
                        Margin="10"
                        Width="400"
                        Height="36"
                        VerticalAlignment="Top">
                    <TextBox x:Name="search"
                             Text="{Binding Url}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="12,6"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             KeyDown="TextBlock_KeyDown"/>
                </Border>
            </Grid>

            <!-- OPTIONS -->
            <!-- OPTIONS -->
            <Grid Grid.Row="0" Grid.Column="2">

                <!-- ⋮ BUTTON -->
                <Border Width="32"
            Height="32"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            CornerRadius="16"
            Margin="10"
            Background="#E9EAEC">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#E9EAEC"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#D0D0D0"
                                                    Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#E9EAEC"
                                                    Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Button x:Name="options"
                Content="⋮"
                FontSize="16"
                Background="Transparent"
                BorderThickness="0"
                FocusVisualStyle="{x:Null}"
                Foreground="#5F6368"
                Click="options_Click"/>
                </Border>

                <!-- MENU (NEM FOLYIK RÁ A GOMBRA) -->
                <Grid x:Name="tab"
          Visibility="Hidden"
          Width="300"
          HorizontalAlignment="Right"
          Margin="0,52,10,0">
                    <!-- 52px lefelé tolva a gomb alá -->

                    <!-- LOGIN -->
                    <Grid x:Name="opt_tab" Visibility="Visible">
                        <Border Style="{StaticResource MenuCard}">
                            <StackPanel>

                                <TextBox x:Name="usr"
                             Text="username"
                             Style="{StaticResource MenuTextBox}"/>

                                <TextBox x:Name="pass"
                             Text="password"
                             Style="{StaticResource MenuTextBox}"/>

                                <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                                    <Button x:Name="login"
                                Content="log in"
                                Style="{StaticResource MenuButton}"
                                Click="login_Click"/>
                                    <Button x:Name="create"
                                Content="create"
                                Style="{StaticResource MenuButton}"
                                Click="create_Click"/>
                                </StackPanel>

                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- SETTINGS -->
                    <Grid x:Name="tab_settings" Visibility="Hidden">
                        <Border Style="{StaticResource MenuCard}">
                            <StackPanel HorizontalAlignment="Center">

                                <Button x:Name="LogOut"
                            Content="log out"
                            Style="{StaticResource MenuButton}"
                            Click="LogOut_Click"/>

                                <ListBox x:Name="eng_opt">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:engine}">
                                            <Button Content="{Binding name}"
                                        Style="{StaticResource MenuButton}"
                                        Click="eng_Click"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
